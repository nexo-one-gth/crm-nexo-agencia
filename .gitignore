# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# claude code local state (worktrees de agentes, permisos locales)
.claude/worktrees/
.claude/settings.local.json

# .claude/skills/ SE VERSIONA: el equipo comparte las mismas skills al clonar.
# Excepción: symlinks generados localmente por `npx skills add` (no portables).
.claude/skills/supabase
.claude/skills/supabase-postgres-best-practices

# Scratch: archivos a borrar a mano (el shell del bridge no puede hacer rm)
_to_delete/
